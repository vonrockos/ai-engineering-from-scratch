   "source": [
    "# Exercise 1\n",
    "use %timeit to compare list comprehension vs numpy for creating an array of 100,000 random numbers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "dba1ce43",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "3.19 ms ± 53 μs per loop (mean ± std. dev. of 7 runs, 100 loops each)\n"
     ]
    }
   ],
   "source": [
    "# list comprehension\n",
    "import random\n",
    "%timeit [random.random() for _ in range(100000)]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "6be6f686",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "312 μs ± 3.53 μs per loop (mean ± std. dev. of 7 runs, 1,000 loops each)\n"
     ]
    }
   ],
   "source": [
    "# np array\n",
    "import numpy as np\n",
    "%timeit np.random.rand(100000)"
   ]
  }
 ],
